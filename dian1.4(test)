#include <ncurses.h>                                                                                                                                                               
#include <string.h>                                                                                                                                                                
#include <ctype.h>                                                                                                                                                                 
#include <limits.h>                                                                                                                                                                
#include<stdio.h>                                                                                                                                                                                   
#define MAX_LINE 256                                                                                                                                                               
#define MAX_HEI 64                                                                                                                                                                 
                                                                                                                                                                                   
int main(int argc,char *argv[])                                                                                                                                                                     
{                                         
FILE *fp;                                                                                                                             
    char input[MAX_HEI][MAX_LINE] = {0},filename[512]={0};                                                                                                                                           
const size_t cap=sizeof(input);
if(argc<2){
fprintf(stderr, " %s work\n", argv[0]);return 0;}
strncpy(filename,argv[1],cap-1);                                                                                       
filename[cap-1]='\0';                                                                                                   
if((fp=fopen(filename,"rb"))==NULL){
      	perror("open error");
		  return 0;}//正确打开文件
      	fseek(fp,0L,SEEK_END);
		  long fsize=ftell(fp);
		  if(fsize==0){
		  perror("open an empty file");
		  }
		  	fseek(fp,0L,SEEK_SET);
	  int r=0,c=0;  
	  int  ch;         
         while(r<MAX_HEI&&(ch=fgetc(fp))!=EOF){
		 //先进行比较，避免超行了还多录入一个字符  
         	if(ch=='\n'){r++;c=0;}
			 else if(ch=='\r'){continue;}
         	else if(ch=='\t'){
         		int standard=4-c%4;
				 while(standard-->0&&c<MAX_LINE){
				 input[r][c++]=' ';	
				 } }//虽然只要换行就OK了但这个也顺便了,逻辑在于制表符标准有standard判断，没空格一次standrad储存的次数就减一
         	else if(isprint((unsigned char)ch)){
			 if(c<MAX_LINE){input[r][c++]=(unsigned char)ch;}
			 }}
			 if(ferror(fp)){
			 	perror(" read error");
			 	fclose(fp);
				  return 0; }
			 if((fclose(fp))==EOF){
			 	perror("close error");//关闭正常
				 return 0;}
    if((initscr())==0){return 0;}                                                                                                                                                  
    raw();                                                                                                                                                                      
    noecho();                                                                                                                                                                      
    keypad(stdscr,TRUE);                                                                                                                                                           
    curs_set(1);                                                                                                                                                                                                                                                                                                                                                    
    char *buffer = (char *)&input;                                                                                                                                                 
    int pos=0,hei=0,y=1,x=1; 
	int top =0,left =0;                                                                                                                                                       
    for(;;){                                                                                                                                                                       
        int row,col;                                                                                                                                                               
        getmaxyx(stdscr,row,col);                                                                                                                                                  
        int v_row=row-y-1,v_col=col-x-1;                                                                                                                                          
        erase();          
		if(hei<top)top=hei;else if(hei>=top+v_row)top=hei-v_row+1;
		if(pos<left)left=pos; else if(pos>=left+v_col)left=pos-v_col+1;                                                                                                                                                        
        for( r=0;r<v_row && top+r< MAX_HEI;r++){                                                                                                                                    
        for( c=0;c<v_col && left+c<MAX_LINE;c++){                                                                                                                                    
                
	              ch=(unsigned char)input[top+r][left+c];                                                                                                                       
                mvaddch(y+r,x+c,ch=='\0'?' ':ch);                                                                                                                                  
                }}refresh(); move(y+hei-top,x+pos-left);                                                                                                                                                                 
        int lm=getch();
		if(lm==17)break;                                                                                                                                                            
        size_t index=(size_t)hei*MAX_LINE+pos;                                                                                                                                     
        switch(lm){                                                                                                                                                                
                case KEY_UP:                                                                                                                                                       
                        if(hei>0)hei--;break;                                                                                                                                      
                case KEY_DOWN:                                                                                                                                                     
                if(hei<MAX_HEI-1)hei++;break;                                                                                                                                      
                case KEY_LEFT:                                                                                                                                                     
                        if(pos>0)pos--;                                                                                                                                            
                        else if(hei>0){pos=MAX_LINE-1;hei--;}                                                                                                                     
                        break;                                                                                                                                                     
                case KEY_RIGHT:                                                                                                                                                    
                        if(pos<MAX_LINE-1)pos++;                                                                                                                                   
                        else if(hei<MAX_HEI-1){pos=0;hei++;}                                                                                                                      
                        break;                                                                                                                                                     
                        default :                                                                                                                                                  
                                if(lm>=0&&lm<=UCHAR_MAX&&isprint((unsigned char)lm)){if(buffer[cap-1]!='\0')break; 
								if(pos==MAX_LINE-1){                                                                                                             
                                        memmove(buffer+index+1,buffer+index,cap-index-1);} 
										else memmove(buffer+index+1,buffer+index,MAX_LINE-pos);                                                                                        
                                        buffer[index]=(unsigned char)lm;                                                                                                           
                                        if(index<cap-1){index++;                                                                                                                   
                                        hei=(int)index/MAX_LINE;pos=(int)index%MAX_LINE;                                                                                           
                                        break;                                                                                                                                     
                                        }                                                                                                                                          
                                }                                                                                                                                                  
                                                                                                                                                                                   
                        }   }                                                                                                                                                       
                endwin();                                                                                                                                                          
                return 1;                                                                                                                                                          
        }(致命问题将input作为一个大数组然后用index检索，当用这种思路处理每行的可打印字符时会带来越界问题)
