int savetxt(char *fname,char input[][MAX_LINE],int fcount){
	FILE *fp; 
	if((fp=fopen(fname,"wb"))==NULL){
		perror("open error");
		return -1;}
	for(int i=0;i<fcount;i++){
		size_t length=(size_t)strlen(input[i]);
		if((fwrite(input[i],1,length,fp))!=length){
			fclose(fp);
			return -1;}
		if(i<fcount-1){
			fputc('\n',fp);
		}}
	 if((fclose(fp))==EOF){
			 	perror("close error");
				 return -1;}
				 return 0;
}					

static void draw_status(int row,int col,const char *filename,int flag,const char *message,int cursor_row,int cursor_col)
{
    char status[512];
    //临时消息
    if (message != NULL && message[0] != '\0') {
        snprintf(status, sizeof(status), "%s", message);
    } else {
        snprintf(status,sizeof(status),"Editing | %s | %s | %d:%d",filename,flag ? "Modified" : "Saved",cursor_row + 1,cursor_col + 1);}
    attron(A_REVERSE);
    mvhline(row - 1, 0, ' ', col);
    //清空前一个状态
    mvaddnstr(row - 1, 0, status, col);
    //只要调整到最下面一行就可以了
    attroff(A_REVERSE);
}				

//默认y=1,x=1就不输入了
static int find_tpart(char * target,int row,int col,char input[][MAX_LINE],int fcount,int cishu){
	if (target == NULL || input == NULL || fcount <= 0) {
        return 0;}
	
	size_t num=(size_t)strlen(target);
	
	if (num == 0) {
        return 0;}
      //hei=-1与pos=-1可以避免没找到也高亮  
	int hei=-1,pos=-1,top=0,left=0,v_row=row-2,v_col=col-2,ch,zd=0;
	
	for (int m = 0; m < fcount; m++) {
        char *match = input[m];
while( (match = strstr(match, target)) != NULL )
        {
            zd++;
            if(zd == cishu)
            {
                hei = m;
                pos = (int)(match - input[m]);
                goto found; // 命中目标匹配，跳出全部循环
            }
            match += 1; 
        }
    }


found:
        if (hei< 0) {return 0;}
        
	
	if(hei<top)top=hei;else if(hei>=top+v_row)top=hei-v_row+1;
		if(pos<left)left=pos; else if(pos>=left+v_col)left=pos-v_col+1;                                                                                                                                                        
        for(int r=0;r<v_row && top+r<fcount;r++){                                                                                                                                    
        for(int c=0;c<v_col && left+c<strlen(input[top+r])+1;c++){                                                                                                                                    
                if(top+r==hei&&pos<=left+c&&left+c<pos+(int)num){
                attron(A_STANDOUT);
				ch=(unsigned char)input[top+r][left+c];                                                                                                                       
                mvaddch(1+r,1+c,ch=='\0'?' ':ch); 
				attroff(A_STANDOUT);}
	              else {
				  ch=(unsigned char)input[top+r][left+c];                                                                                                                       
                mvaddch(1+r,1+c,ch=='\0'?' ':ch); }                                                                                                                                
                }}move(1+hei-top,1+pos-left);refresh();
				return 1;
				}
				
int copy(char input[][MAX_LINE],int fcount,int shei,int spos,int ehei,int epos,char *clip,int clmax,int *out_len)
{
    int idx = 0;
    *out_len = 0;
    //应对方向键左移的时候，交换起始
    if(shei > ehei || (shei == ehei && spos > epos)){
        int th = shei; int tp = spos;
        shei = ehei; spos = epos;
        ehei = th; epos = tp;
    }
//即使只有一行也ok
    for(int h = shei; h <= ehei; h++)
    {
        char *line = input[h];
        int length = (int)strlen(line);
        int cbegin = (h == shei) ? spos : 0;
        int cend   = (h == ehei) ? epos : length;

        for(int c = cbegin; c < cend; c++)
        {
            if(idx >= clmax - 2) return 1;
            clip[idx++]= line[c];
        }
        if(h != ehei){ //行之间加换行符
            if(idx >= clmax -2) return 1;
            clip[idx++] = '\n';
        }
    }
    clip[idx] = '\0';
    *out_len = idx;
    return 0;
}
			
void delete(char input[][MAX_LINE],int *fcount,int *cur_hei,int *cur_pos,int shei,int spos,int ehei,int epos)
{
    //同上
    if(shei > ehei || (shei == ehei && spos > epos)){
        int th = shei; int tp = spos;
        shei = ehei; spos = epos;
        ehei = th; epos = tp;
    }

    //同一行只要memmove
    if(shei == ehei)
    {
        char *line = input[shei];
        int len = (int)strlen(line);
        memmove(line + spos, line + epos, len - epos + 1);
        *cur_hei = shei;
        *cur_pos = spos;
        return;
    }

    //跨多行先处理最后一行到第一行，然后把中间删掉，最后总的平移指针
    input[shei][spos] = '\0';
    char *last = input[ehei];
    size_t slen = strlen(input[shei]);
    if(slen + strlen(last) >= MAX_LINE){
        
        input[shei][MAX_LINE-1] = '\0';
    }else{
        strcat(input[shei], last);
    }
    
    int delcount = ehei - shei;
    for(int r = shei+1 ; r < *fcount - delcount; r++)
    {
        memcpy(input[r], input[r + delcount], MAX_LINE);
    }
    *fcount -= delcount;
    input[*fcount][0] = '\0';

    *cur_hei = shei;
    *cur_pos = (int)slen;
}

//粘贴clip_buf到光标(hei,pos)，修改input,fcount，移动光标
void paste(char input[][MAX_LINE],int *fcount,int *hei,int *pos, const char *clip,int cllen)
{
    if(cllen <=0) return;
    char tmp_line[MAX_LINE]={0};
    int cur_h = *hei;
    int cur_p = *pos;

    //把当前行拆分成两部分
    strncpy(tmp_line, input[cur_h], MAX_LINE-1);
    tmp_line[MAX_LINE-1]='\0';

    char head[MAX_LINE]={0},tail[MAX_LINE]={0};
    strncpy(head, tmp_line, cur_p);
    head[cur_p] = '\0';
    strcpy(tail, tmp_line + cur_p);

    //按'\n'分割剪贴板多行
    const char *p = clip;
    int lines = 0;
    //统计剪贴板换行数量
    for(int i=0;i<cllen;i++){
        if(clip[i] == '\n') lines++;
    }

    //腾出空间，向后移动行
    if(*fcount + lines >= MAX_HEI){
        beep();
        return;
    }
    for(int r = *fcount; r > cur_h + 1 + lines; r--){
        memcpy(input[r], input[r-1], MAX_LINE);
    }
    *fcount += lines;

    //第一行粘贴：head + 剪贴板第一行
    const char *nl = strchr(p,'\n');
    if(nl == NULL){
        //剪贴板只有单行
        snprintf(input[cur_h],MAX_LINE,"%s%s%s",head,p,tail);
        *pos = cur_p + (int)strlen(p);
        return;
    }else{
        size_t part1_len = nl - p;
        char part1[MAX_LINE]={0};
        strncpy(part1,p,part1_len);
        snprintf(input[cur_h],MAX_LINE,"%s%s",head,part1);
        p = nl +1;
        //中间行
        int ins_h = cur_h+1;
        while(p!=NULL && *p!='\0'){
            nl = strchr(p,'\n');
            if(nl != NULL){
                size_t pl = nl-p;
                strncpy(input[ins_h],p,pl);
                input[ins_h][pl]='\0';
                ins_h++;
                p = nl+1;
            }else{
                //最后一段拼接tail
                snprintf(input[ins_h],MAX_LINE,"%s%s",p,tail);
                p = NULL;
            }
        }
        *hei = ins_h;
        *pos = (int)strlen(input[ins_h]);
    }
}
					                 
                                                                                                                                              
