	for (int m = 0; m < fcount; m++) {
        char *match = input[m];
while( (match = strstr(match, target)) != NULL )
        {
            zd++;
            if(zd == cishu)
            {
                hei = m;
                pos = (int)(match - input[m]);
                goto found; // 命中目标匹配，跳出全部循环
            }
            match += 1; 
        }
    }


found:
        if (hei< 0) {return 0;}
        
	
	if(hei<top)top=hei;else if(hei>=top+v_row)top=hei-v_row+1;
		if(pos<left)left=pos; else if(pos>=left+v_col)left=pos-v_col+1;                                                                                                                                                        
