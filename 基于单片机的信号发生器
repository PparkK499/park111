#include "stm32f10x.h"                 
#include "Delay.h"
#include "OLED.h"
#include "Servo.h"
#include "Key.h"
#include "dds_pwm.h"
#include "Encoder.h"

#define Square 1
#define Sinwave 0

uint16_t count1=0,count2=0,count3=0;
uint8_t KeyNum;
uint16_t freq=36;
uint8_t Choice=1;
uint8_t mark=Square;

uint16_t duty=500;
int16_t sinfreq=1000;
int16_t addfreq=0;

uint16_t F1[3]={36,18,12};
uint16_t F2[3]={500,1000,1500};
int16_t F3[3]={1000,2000,3000};

uint8_t ModeChangeFlag = 1;   //模式切换标志

void OLED_Refresh(void)
{
    if(mark == Square)
    {
        OLED_Clear();
        OLED_ShowString(1, 1, "FREQ:");
        OLED_ShowString(2, 1, "DUTY:");
        OLED_ShowString(1, 12, "HZ");
        OLED_ShowChar(2,12,'%');
        OLED_ShowNum(1,7,36000/freq,5);
        OLED_ShowNum(2,7,duty/20,5);
    }
    else if(mark == Sinwave)
    {
        OLED_Clear();
        OLED_ShowString(1, 1, "BASICFREQ:");
        OLED_ShowString(2, 1, "ACCFREQ:");
        OLED_ShowNum(1, 12, sinfreq,5);
        OLED_ShowNum(2, 10, sinfreq+addfreq,5);
        OLED_ShowString(1, 17, "HZ");
        OLED_ShowString(2, 17, "HZ");
    }
}

int main(void)
{
	OLED_Init();
	Servo1_Init();
	Servo2_Init();
	Key_Init();
	Encoder_Init();

	mark = Square;
	OLED_Refresh();

	while (1)
	{
		KeyNum = Key_GetNum();

		//模式切换
		if(KeyNum != 0)
		{
			if(KeyNum == 1 || KeyNum == 2)
			{
			    if(Choice != Square)
			    {
			        Choice = Square;
			        ModeChangeFlag = 1;
			    }
			}
			else if(KeyNum == 3)
			{
			    if(Choice != Sinwave)
			    {
			        Choice = Sinwave;
			        ModeChangeFlag = 1;
			    }
			    else
			    {
			        //正弦模式下，按KEY3切换基础频率档位
			        count3++;
			        count3 %=3;
			        sinfreq=F3[count3];
			        DDS_SetFreq(100000, sinfreq + addfreq);
			        OLED_Refresh();
			    }
			}
		}

		if(Choice == Square)
		{
		    mark = Square;
		    if(ModeChangeFlag)
		    {
		        ModeChangeFlag = 0;
		        OLED_Refresh();
		    }

		    if(KeyNum == 1)
		    {
		        count1++;
		        count1%=3;
		        freq=F1[count1];
		        Servo_SetFreq(freq);
		        OLED_Refresh();
		    }
		    else if(KeyNum == 2)
		    {
		        count2++;
		        count2%=3;
		        duty=F2[count2];
		        Servo_SetDuty(duty);
		        OLED_Refresh();
		    }
		}
		else // Sinwave模式
		{
		    mark = Sinwave;
		    //刚切进正弦模式，仅执行一次初始化
		    if(ModeChangeFlag)
		    {
		        ModeChangeFlag = 0;
		        count3 = 0;
		        sinfreq=F3[count3];
		        addfreq = 0;
		        dds.phase_acc = 0;   //仅进入模式复位相位
		        DDS_SetFreq(100000, sinfreq + addfreq);
		        OLED_Refresh();
		    }

		    int16_t enc_val = Encoder_Get();
		    if(enc_val != 0)
		    {
		        addfreq += enc_val;
		        //双向限幅 -999 ~ +999
		        if(addfreq > 999)  addfreq = 999;
		        if(addfreq < -999) addfreq = -999;

		        DDS_SetFreq(100000, sinfreq + addfreq);
		        OLED_Refresh();
		    }
		}

		Delay_ms(20);
	}
}

